{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Taskira",
  "version": "0.4.0",
  "identifier": "com.frankluongo.taskira",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev -w apps/web",
      "cwd": "../../../"
    },
    "beforeBuildCommand": {
      "script": "npm run build -w apps/web",
      "cwd": "../../../"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Taskira",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
